### Set default index file
DirectoryIndex index.html 

### Prevent directory listing
Options -Indexes +FollowSymLinks

### Force HTTPS (if SSL is installed)
RewriteEngine On
### Ensure Authorization header is passed to PHP (ADD THIS BLOCK)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
### Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

### Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

### (Optional) Force www/non-www
# Option 1: Force www (e.g., https://www.vasventures.in)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Option 2: Force non-www (e.g., https://vasventures.in)
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://vasventures.in%{REQUEST_URI} [L,R=301]

### Security: Block access to .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

### Disable server signature (hide Apache version)
ServerSignature Off

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
